# ============================================================
# ArcX — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.
# ============================================================

# --- Required ---

# Private key for the facilitator wallet.
# This wallet submits transferWithAuthorization txs on-chain and pays gas.
# Arc features unified USDC: holding USDC covers both token transfers and gas.
FACILITATOR_PRIVATE_KEY=0x_your_facilitator_wallet_private_key_here

# Address that receives USDC payments from API consumers.
# Can be the same as the facilitator wallet, or a separate cold wallet.
PAYTO_ADDRESS=0x_your_receiving_wallet_address_here

# --- Optional (have sane defaults) ---

# Arc mainnet RPC endpoint
ARC_RPC_URL=https://rpc.mainnet.arc.io

# Server port
PORT=4402

# Price per API call in USDC (6-decimal units)
# 1000 = $0.001, 10000 = $0.01, 100000 = $0.10
PRICE_PER_CALL=1000

# Rate limiting — per wallet
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# SQLite database file path (relative to server root)
DB_PATH=./data/arcx.db

# Logging level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Node environment
NODE_ENV=production
