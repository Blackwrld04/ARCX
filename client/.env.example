# Agent wallet private key (must have USDC on Arc mainnet)
AGENT_PRIVATE_KEY=0x_your_agent_wallet_private_key_here

# ArcX API URL (use your live Render or Netlify URL in production)
# Both API_URL and BACKEND_URL are supported interchangeably
API_URL=http://localhost:4402

# Number of queries to make (default: 1)
NUM_QUERIES=1
